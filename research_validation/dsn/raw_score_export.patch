+
+def export_TranAD_score_arrays(
+    model,
+    train_dataloader,
+    test_dataloader,
+    alpha=0.5,
+    beta=0.5,
+    device='cpu',
+) -> dict[str, np.ndarray]:
+    """Run inference once and return raw anomaly-score/label arrays.
+
+    This deliberately performs no threshold selection and computes no F1.
+    The arrays are for a separate frozen calibration/test procedure.
+    """
+    loss_fn = nn.MSELoss(reduction='none')
+
+    loss_test, _, _, _, anoms_test = gen_TranAD_predictions(
+        model, loss_fn, test_dataloader, alpha=alpha, beta=beta, device=device
+    )
+    loss_train, _, _, _, anoms_train = gen_TranAD_predictions(
+        model, loss_fn, train_dataloader, alpha=alpha, beta=beta, device=device
+    )
+
+    return {
+        "train_scores_global": np.mean(loss_train, axis=1),
+        "test_scores_global": np.mean(loss_test, axis=1),
+        "train_scores_per_channel": loss_train,
+        "test_scores_per_channel": loss_test,
+        "train_labels_global": (np.sum(anoms_train, axis=1) >= 1).astype(np.uint8),
+        "test_labels_global": (np.sum(anoms_test, axis=1) >= 1).astype(np.uint8),
+        "train_labels_per_channel": anoms_train.astype(np.uint8),
+        "test_labels_per_channel": anoms_test.astype(np.uint8),
+    }
